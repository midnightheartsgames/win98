{"game":"heroes98-map","v":1,"name":"Союз пяти","about":"Третья миссия кампании «Тысячелетие».","w":112,"h":112,"levels":1,"players":[{"who":"human","factions":["throne"],"team":0,"town":1},{"who":"ai","factions":["throne"],"team":1,"town":2}],"goals":{"win":[{"kind":"flag","flag":"n_never","text":"Выполнить задания миссии"}],"lose":[{"kind":"all"},{"kind":"hero","hid":"valeria"},{"kind":"town","town":1}]},"forbid":[],"heart":null,"next":60,"ter":[""],"road":[""],"river":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AMQ=="],"over":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AMQ=="],"objs":[{"id":1,"l":0,"t":"town","c":50,"r":52,"owner":0,"faction":"throne","name":"Серебряный Порог","tag":"home","built":["hall1","hall2","fort1","fort2","tavern","market","smith","store","dwell1","dwell2","dwell3","dwell4","dwell5","guild1","guild2"],"forbid":["hall4","dwell6","dwell6u","dwell7","dwell7u","altar","shipyard"]},{"id":2,"l":0,"t":"town","c":52,"r":6,"owner":1,"faction":"throne","name":"Зеркальная застава","tag":"post","built":["hall1","fort1","fort2"],"forbid":["tavern","dwell1","dwell1u","dwell2","dwell2u","dwell3","dwell3u","dwell4","dwell4u","dwell5","dwell5u","dwell6","dwell6u","dwell7","dwell7u","altar","shipyard","hall3","hall4","guild1","market","caravan"],"garrison":[{"unit":"legionary","count":40},{"unit":"moonarcher","count":14},{"unit":"mirrorguard","count":8}]},{"id":3,"l":0,"t":"monster","c":38,"r":100,"owner":-1,"unit":"crossbow","count":40,"max":120,"mood":"fierce","tag":"cloaks"},{"id":4,"l":0,"t":"monster","c":20,"r":40,"owner":-1,"unit":"mirrorguard","count":26,"max":78,"mood":"fierce","tag":"pillar"},{"id":5,"l":0,"t":"monster","c":32,"r":8,"owner":-1,"unit":"pirates","count":36,"max":108,"mood":"fierce","tag":"dredge"},{"id":6,"l":0,"t":"petitioner","c":56,"r":98,"owner":-1,"tag":"adel","quest":{"kind":"kill","obj":3},"reward":{"gold":1000}},{"id":7,"l":0,"t":"petitioner","c":98,"r":56,"owner":-1,"tag":"ais","quest":{"kind":"res","res":{"salt":6}},"reward":{"gold":1000}},{"id":8,"l":0,"t":"petitioner","c":10,"r":56,"owner":-1,"tag":"ved","quest":{"kind":"kill","obj":4},"reward":{"gold":1000}},{"id":9,"l":0,"t":"petitioner","c":18,"r":16,"owner":-1,"tag":"nae","quest":{"kind":"kill","obj":5},"reward":{"gold":1000}},{"id":10,"l":0,"t":"petitioner","c":92,"r":18,"owner":-1,"tag":"irg","quest":{"kind":"res","res":{"ore":10,"sulfur":4}},"reward":{"gold":1000}},{"id":11,"l":0,"t":"saltworks","c":88,"r":72,"owner":-1},{"id":12,"l":0,"t":"monster","c":90,"r":74,"owner":-1,"unit":"shade","count":40,"max":120,"mood":"hostile"},{"id":13,"l":0,"t":"sulfurspring","c":84,"r":26,"owner":-1},{"id":14,"l":0,"t":"monster","c":86,"r":28,"owner":-1,"unit":"salamander","count":16,"max":48,"mood":"hostile"},{"id":15,"l":0,"t":"oremine","c":100,"r":30,"owner":-1},{"id":16,"l":0,"t":"monster","c":102,"r":32,"owner":-1,"unit":"apprentice","count":40,"max":120,"mood":"hostile"},{"id":17,"l":0,"t":"oremine","c":40,"r":64,"owner":-1},{"id":18,"l":0,"t":"monster","c":42,"r":66,"owner":-1,"unit":"legionary","count":30,"max":90,"mood":"hostile"},{"id":19,"l":0,"t":"sawmill","c":62,"r":64,"owner":-1},{"id":20,"l":0,"t":"goldmine","c":70,"r":42,"owner":-1},{"id":21,"l":0,"t":"monster","c":72,"r":44,"owner":-1,"unit":"whitespirit","count":10,"max":30,"mood":"hostile"},{"id":22,"l":0,"t":"moonrift","c":40,"r":42,"owner":-1},{"id":23,"l":0,"t":"monster","c":42,"r":44,"owner":-1,"unit":"silverspirit","count":3,"max":9,"mood":"hostile"},{"id":24,"l":0,"t":"dwell-deerrider","c":66,"r":82,"owner":-1},{"id":25,"l":0,"t":"monster","c":68,"r":84,"owner":-1,"unit":"silverspirit","count":3,"max":9,"mood":"hostile"},{"id":26,"l":0,"t":"artifact","c":6,"r":92,"owner":-1,"art":"moonamulet"},{"id":27,"l":0,"t":"monster","c":7,"r":93,"owner":-1,"unit":"werewolf","count":30,"max":90,"mood":"hostile"},{"id":28,"l":0,"t":"artifact","c":104,"r":98,"owner":-1,"art":"khanaxe"},{"id":29,"l":0,"t":"monster","c":105,"r":99,"owner":-1,"unit":"horsebow","count":30,"max":90,"mood":"hostile"},{"id":30,"l":0,"t":"res-salt","c":90,"r":50,"owner":-1},{"id":31,"l":0,"t":"res-salt","c":104,"r":66,"owner":-1},{"id":32,"l":0,"t":"res-salt","c":86,"r":60,"owner":-1},{"id":33,"l":0,"t":"res-sulfur","c":98,"r":10,"owner":-1},{"id":34,"l":0,"t":"res-sulfur","c":80,"r":16,"owner":-1},{"id":35,"l":0,"t":"res-ore","c":86,"r":22,"owner":-1},{"id":36,"l":0,"t":"res-ore","c":100,"r":22,"owner":-1},{"id":37,"l":0,"t":"res-ore","c":60,"r":70,"owner":-1},{"id":38,"l":0,"t":"res-gold","c":44,"r":60,"owner":-1},{"id":39,"l":0,"t":"res-gold","c":62,"r":46,"owner":-1},{"id":40,"l":0,"t":"res-gold","c":30,"r":56,"owner":-1},{"id":41,"l":0,"t":"res-gold","c":76,"r":56,"owner":-1},{"id":42,"l":0,"t":"res-gold","c":56,"r":30,"owner":-1},{"id":43,"l":0,"t":"res-gold","c":56,"r":80,"owner":-1},{"id":44,"l":0,"t":"res-gold","c":20,"r":90,"owner":-1},{"id":45,"l":0,"t":"res-gold","c":92,"r":90,"owner":-1},{"id":46,"l":0,"t":"res-moonsilver","c":46,"r":40,"owner":-1},{"id":47,"l":0,"t":"res-moonsilver","c":66,"r":66,"owner":-1},{"id":48,"l":0,"t":"campfire","c":40,"r":52,"owner":-1},{"id":49,"l":0,"t":"campfire","c":70,"r":60,"owner":-1},{"id":50,"l":0,"t":"campfire","c":56,"r":36,"owner":-1},{"id":51,"l":0,"t":"signstone","c":56,"r":88,"owner":-1,"text":"Дельта Семи Рек. Мельничный Брод в трёх днях пути, если не останавливаться у трактиров."},{"id":52,"l":0,"t":"signstone","c":88,"r":56,"owner":-1,"text":"Степь Ак-Туз. Курганы просят тишины, кони не слушают."},{"id":53,"l":0,"t":"signstone","c":22,"r":56,"owner":-1,"text":"Заповедная Чаща. Рубить нельзя, ругаться можно тихо."},{"id":54,"l":0,"t":"signstone","c":26,"r":22,"owner":-1,"text":"Берег Чаши. Колыбельную здесь поют даже рыбаки, но фальшиво."},{"id":55,"l":0,"t":"signstone","c":88,"r":26,"owner":-1,"text":"Пепельные Горнила. Не трогай горячее, всё горячее."},{"id":56,"l":0,"t":"rock","c":4,"r":108,"owner":-1},{"id":57,"l":0,"t":"rock","c":108,"r":108,"owner":-1},{"id":58,"l":0,"t":"rock","c":108,"r":40,"owner":-1},{"id":59,"l":0,"t":"rock","c":4,"r":40,"owner":-1}],"heroes":[{"owner":0,"hid":"valeria","c":52,"r":54,"l":0,"tag":"valeria","army":[{"unit":"legionary","count":50},{"unit":"moonarcher","count":16},{"unit":"mirrorguard","count":8},{"unit":"moonmaiden","count":5},{"unit":"deerrider","count":2}]},{"owner":1,"hid":"cassian","c":54,"r":9,"l":0,"tag":"cassian","patrol":4,"army":[{"unit":"legionary","count":30},{"unit":"moonarcher","count":10},{"unit":"moonmaiden","count":4}]}],"events":[],"scenes":"event day 1 -> v3_start\nevent day 12 -> v3_raid\nevent done adel -> v3_adel\nevent done ais -> v3_ais\nevent done ved -> v3_ved\nevent done nae -> v3_nae\nevent done irg -> v3_irg\nevent flag v3_all -> v3_win\n\n@v3_start\nshow valeria left\nshow adelina right\nadelina: Пять краёв, пять человек, которые весь год воевали с Орденом. Каждый по-своему и каждый один.\nvaleria: И каждый захочет доказательств, что я не регент в другом плаще.\nadelina: Захочет. Я бы захотела. Начни с того, о чём они просят.\ngoal add adel \"Лига: Аделина просит разбить белых плащей у Мельничного Брода\" to cloaks adel\ngoal add ais \"Курганы: Айсулу просит соль для тризны\" to ais\ngoal add ved \"Чаща: Ведана просит разбить зеркальный столб\" to pillar ved\ngoal add nae \"Прилив: Наэра просит прогнать черпальню с берега\" to dredge nae\ngoal add irg \"Горнила: Ирга просит руду и серу\" to irg\nsay Каждый, кому вы поможете, придёт к Валерии героем, с войском и всем, что заслужил за свой год.\nif kept knights_out\nshow marcella right\nmarcella: Рыцари из Старой конюшни здесь. Пойдут туда, куда вы скажете.\ngive unit throneknight 2\nend\nif kept aisulu_led\nshow aisulu right\naisulu: Я пришла раньше. Аделина когда-то довела меня до кургана, теперь моя очередь вести.\nrecall aisulu 53 58 0 aisulu\narmy aisulu shade 40 horsebow 12\nif kept kaidar_host\narmy aisulu stonewoman 8 bonebull 2\nend\ngoal done ais\nset j2\nend\nend\n\n@v3_raid\nif not flag v3_all\nshow lucretia right\nlucretia: Наследница собирает чужих. Застава напомнит ей, кто здесь свой.\nspawn hero lucretia 1 52 20 0 raid\narmy raid legionary 30 moonarcher 10\nif not diff easy\narmy raid mirrorguard 8 moonmaiden 4\nend\naim player 1 home\nend\nend\n\n@v3_adel\nshow adelina right\nadelina: Белые плащи разбиты. Среди пленных Мальс, бургомистр Звонграда.\nshow malse right\nmalse: Меня никто не заставлял. Я просто плохо считал: Орден платил больше, чем стоили карты.\nshow adelina right\nadelina: Цеха Звонграда дадут ополчение. И я пойду с ним.\nrecall adelina 57 101 0 adelina\narmy adelina militia 40 crossbow 16\nif kept spared_villages\narmy adelina pikeman 20\nend\ngoal done adel\nset j1\nscene v3_check\nend\n\n@v3_ais\nif flag j2\nshow aisulu right\naisulu: Соль на тризну принесена. Предки довольны, хотя я и так уже здесь.\nelse\nshow aisulu right\naisulu: Соль на тризну принесена. Предки слышат, что о них помнят, даже если помнит чужая наследница.\nif kept kaidar_host\naisulu: Рать Кайдар-хана идёт со мной. Хан отдал её, чтобы я спросила с Ордена за его венец.\nend\nrecall aisulu 99 59 0 aisulu\narmy aisulu shade 40 horsebow 12\nif kept kaidar_host\narmy aisulu stonewoman 8 bonebull 2\nend\ngoal done ais\nset j2\nend\nscene v3_check\nend\n\n@v3_ved\nshow vedana right\nvedana: Столб разбит. Лес слышит место, где он стоял, как слышит пень, где стояло дерево.\nif kept snake_alive\nvedana: Змей идёт с нами. Говорит, ни разу не летал так далеко от озера, и это хороший повод.\nend\nrecall vedana 12 59 0 vedana\narmy vedana werewolf 20 bereginya 10\nif kept snake_alive\narmy vedana zmey 1\nend\ngoal done ved\nset j3\nscene v3_check\nend\n\n@v3_nae\nshow naera right\nnaera: Черпальня ушла. Вода снова поёт, хоть и тихо.\nif kept merra_spared\nshow merra right\nmerra: Я тоже здесь. Я отдала регенту сердце, теперь хочу видеть, что он с ним сделает.\nshow naera right\nnaera: Она пойдёт со мной. Сестра остаётся сестрой.\nend\nrecall naera 20 19 0 naera\narmy naera shellman 40 seawitch 8\nif kept merra_spared\narmy naera seawitch 6\nend\ngoal done nae\nset j4\nscene v3_check\nend\n\n@v3_irg\nshow irga right\nirga: Руда и сера. Хватит на один горн. Ты знаешь, что я сделала со своей половиной цепи?\nvaleria: Знаю. Ты поставила шов, который лопнет, если цепью держать луну против воли.\nirga: Тогда ты знаешь, зачем я иду.\nrecall irga 94 21 0 irga\narmy irga apprentice 40 salamander 10\nif kept guilds_sworn\narmy irga caster 8\nend\ngoal done irg\nset j5\nscene v3_check\nend\n\n@v3_check\nif flag j1\nif flag j2\nif flag j3\nif flag j4\nif flag j5\nset v3_all\nend\nend\nend\nend\nend\nend\n\n@v3_win\nshow valeria left\nshow adelina right\nadelina: Пять краёв с тобой. Не думала, что увижу это при жизни.\nshow severin right\nseverin: Красиво. Ты собрала всех, кого Орден обидел за год. Только год кончается.\nvaleria: Схождение в первую ночь тысячного года. Мы успеем.\nseverin: Луне не нужно ждать Схождения, если у неё есть сердце и цепь. Я начинаю подъём сейчас. До ночи Схождения двадцать восемь дней.\nwin\nend\n"}