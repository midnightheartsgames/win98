r":-1,"unit":"blackspider","count":14,"max":42,"mood":"fierce","tag":"glass"},{"id":7,"l":0,"t":"petitioner","c":56,"r":70,"owner":-1,"tag":"q4","quest":{"kind":"kill","obj":6},"reward":{"gold":1500}},{"id":8,"l":0,"t":"artifact","c":26,"r":36,"owner":-1,"art":"militiahelm"},{"id":9,"l":0,"t":"artifact","c":28,"r":46,"owner":-1,"art":"crestcap"},{"id":10,"l":0,"t":"artifact","c":44,"r":44,"owner":-1,"art":"owlmask"},{"id":11,"l":0,"t":"monster","c":45,"r":45,"owner":-1,"unit":"obsidianspider","count":16,"max":48,"mood":"fierce"},{"id":12,"l":0,"t":"sulfurspring","c":34,"r":10,"owner":-1},{"id":13,"l":0,"t":"monster","c":36,"r":12,"owner":-1,"unit":"salamander","count":14,"max":42,"mood":"hostile"},{"id":14,"l":0,"t":"sulfurspring","c":46,"r":70,"owner":-1},{"id":15,"l":0,"t":"monster","c":48,"r":72,"owner":-1,"unit":"obsidianspider","count":10,"max":30,"mood":"hostile"},{"id":16,"l":0,"t":"oremine","c":16,"r":50,"owner":-1},{"id":17,"l":0,"t":"monster","c":18,"r":52,"owner":-1,"unit":"hammerer","count":14,"max":42,"mood":"hostile"},{"id":18,"l":0,"t":"sawmill","c":4,"r":52,"owner":-1},{"id":19,"l":0,"t":"goldmine","c":52,"r":34,"owner":-1},{"id":20,"l":0,"t":"monster","c":54,"r":36,"owner":-1,"unit":"caster","count":8,"max":24,"mood":"hostile"},{"id":21,"l":0,"t":"res-sulfur","c":24,"r":14,"owner":-1},{"id":22,"l":0,"t":"res-sulfur","c":30,"r":66,"owner":-1},{"id":23,"l":0,"t":"res-sulfur","c":62,"r":14,"owner":-1},{"id":24,"l":0,"t":"res-sulfur","c":61,"r":61,"owner":-1},{"id":25,"l":0,"t":"res-ore","c":14,"r":30,"owner":-1},{"id":26,"l":0,"t":"res-ore","c":26,"r":52,"owner":-1},{"id":27,"l":0,"t":"res-ore","c":50,"r":46,"owner":-1},{"id":28,"l":0,"t":"res-gold","c":22,"r":40,"owner":-1},{"id":29,"l":0,"t":"res-gold","c":34,"r":30,"owner":-1},{"id":30,"l":0,"t":"res-gold","c":46,"r":50,"owner":-1},{"id":31,"l":0,"t":"res-gold","c":12,"r":64,"owner":-1},{"id":32,"l":0,"t":"res-gold","c":66,"r":26,"owner":-1},{"id":33,"l":0,"t":"campfire","c":30,"r":40,"owner":-1},{"id":34,"l":0,"t":"campfire","c":54,"r":40,"owner":-1},{"id":35,"l":0,"t":"chest","c":76,"r":4,"owner":-1,"offer":2},{"id":36,"l":0,"t":"monster","c":77,"r":5,"owner":-1,"unit":"caster","count":10,"max":30,"mood":"hostile"},{"id":37,"l":0,"t":"signstone","c":18,"r":12,"owner":-1,"text":"Цех литейщиков. Испытание: приведи тех, кто держит ковш."},{"id":38,"l":0,"t":"signstone","c":18,"r":66,"owner":-1,"text":"Цех кузнецов. Испытание: принеси шлем лучше нашего."},{"id":39,"l":0,"t":"signstone","c":54,"r":12,"owner":-1,"text":"Цех серников. Испытание: принеси то, что мы и так продаём."},{"id":40,"l":0,"t":"signstone","c":54,"r":64,"owner":-1,"text":"Цех стеклодувов. Испытание: прогони чёрных пауков от нашей пещеры."},{"id":41,"l":0,"t":"rock","c":4,"r":4,"owner":-1},{"id":42,"l":0,"t":"rock","c":76,"r":76,"owner":-1},{"id":43,"l":0,"t":"rock","c":4,"r":76,"owner":-1},{"id":44,"l":0,"t":"rock","c":36,"r":4,"owner":-1},{"id":45,"l":0,"t":"rock","c":36,"r":76,"owner":-1}],"heroes":[{"owner":0,"hid":"irga","c":12,"r":40,"l":0,"tag":"irga","army":[{"unit":"apprentice","count":60},{"unit":"hammerer","count":20},{"unit":"salamander","count":20},{"unit":"obsidianspider","count":12},{"unit":"caster","count":6}]},{"owner":1,"hid":"tamma","c":72,"r":40,"l":0,"tag":"tamma","patrol":1,"army":[{"unit":"apprentice","count":30},{"unit":"salamander","count":10}]}],"events":[],"scenes":"event day 1 -> h4_start\nevent done q1 -> h4_q1\nevent done q2 -> h4_q2\nevent done q3 -> h4_q3\nevent done q4 -> h4_q4\nevent day 15 -> h4_elders\nevent defeat garm -> h4_garm\nevent flag h4_all -> h4_win\n\n@h4_start\nshow irga left\nshow brant right\nbrant: Цеха готовы присягнуть. Но каждый хочет испытание. Старый обычай.\nirga: Обычай хороший. Только старшие ведут войско, а ждать оно не будет.\nbrant: Две недели. Потом оно придёт к Литейной.\ngoal add q1 \"Испытание литейщиков\" to q1\ngoal add q2 \"Испытание кузнецов\" to q2\ngoal add q3 \"Испытание серников\" to q3\ngoal add q4 \"Испытание стеклодувов\" to q4 glass\nsay Кузнецы просят редкий шлем. Два простых шлема можно перековать в Великом горне.\nif kept judges_freed\nshow brant right\nbrant: Отпущенные судьи сдержали слово. Литейщики прислали подмастерьев без испытания на верность.\ngive unit caster 6\nend\nend\n\n@h4_q1\nshow brant right\nbrant: Литейщики присягнули. Их мастер сказал, что расплав не разбирает, за кого льётся, но они разбирают.\ngive unit caster 8\ngoal done q1\nset t1\nscene h4_check\nend\n\n@h4_q2\nshow irga left\nirga: Кузнецы взяли шлем и долго смотрели на шов. Потом сказали, что такой шов можно доверить войне.\ngive unit hammerer 20\ngoal done q2\nset t2\nscene h4_check\nend\n\n@h4_q3\nshow ilm right\nilm: Серники с нами. Привели паровиков. Обещали, что те не взорвутся без приказа.\ngive unit steamling 2\ngoal done q3\nset t3\nscene h4_check\nend\n\n@h4_q4\nshow brant right\nbrant: Стеклодувы присягнули последними. Им понравилось, как мы разбили тех, кто стоял у пещеры.\ngive unit glassblower 6\ngoal done q4\nset t4\nscene h4_check\nend\n\n@h4_elders\nif not flag h4_all\nspawn hero garm 1 66 44 0 garm\narmy garm apprentice 30 salamander 10\nif not diff easy\narmy garm slaggiant 1 caster 6 apprentice 10\nend\nif diff impossible\narmy garm slaggiant 2 caster 10 steamling 3\nend\nshow garm right\ngarm: Испытания, присяги. Ты играешь в старые игры, кузнечиха. А я привёл войско.\ngoal add garm \"Отбить войско старших\" to garm\naim player 1 home\nend\nend\n\n@h4_garm\nshow irga left\nirga: Гарм ушёл. Не разбит, просто ушёл. Он умеет считать потери.\ngoal done garm\nset gb\nscene h4_check\nend\n\n@h4_check\nif flag t1\nif flag t2\nif flag t3\nif flag t4\nif day 15\nif flag gb\nset h4_all\nend\nelse\nkeep guilds_sworn\nset h4_all\nend\nend\nend\nend\nend\nend\n\n@h4_win\nshow irga left\nshow ilm right\nilm: Четыре цеха с тобой. А Гарм послал гонца к Белым руинам. Просит Престол о помощи.\nirga: Старший горн просит помощи у тех, кому продал цепи.\nilm: Он говорит, что это тоже сделка.\nirga: У него всё сделка. Посмотрим, сколько стоит Старый Горн.\nwin\nend\n"}