{"game":"heroes98-map","v":1,"name":"Набат","about":"Пятая миссия кампании «Набат».","w":80,"h":80,"levels":1,"players":[{"who":"human","factions":["league"],"team":0,"town":1},{"who":"ai","factions":["barrows"],"team":1,"town":null}],"goals":{"win":[{"kind":"flag","flag":"n_never","text":"Выполнить задания миссии"}],"lose":[{"kind":"all"},{"kind":"hero","hid":"adelina"}]},"forbid":[],"heart":null,"next":48,"ter":[""],"road":[""],"river":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AGQ=="],"over":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AGQ=="],"objs":[{"id":1,"l":0,"t":"town","c":38,"r":44,"owner":0,"faction":"league","name":"Звонград","tag":"zvongrad","built":["hall1","hall2","hall3","fort1","fort2","fort3","tavern","market","store","smith","caravan","guild1","guild2","guild3","dwell1","dwell2","dwell3","dwell4","dwell5","dwell6","dwell1u","dwell2u","dwell3u","special1","special2","special3","special4"],"branch":{"1":"a","2":"a","3":"a"},"forbid":["hall4","altar","shipyard"],"garrison":[{"unit":"pikeman","count":60},{"unit":"heavycrossbow","count":30},{"unit":"alarmist","count":14},{"unit":"plated","count":10}]},{"id":2,"l":0,"t":"town","c":8,"r":64,"owner":0,"faction":"league","name":"Мельничный Брод","tag":"brod","built":["hall1","hall2","fort1","fort2","tavern","market","dwell1","dwell2","dwell3","caravan","smith"],"forbid":["hall4","altar","shipyard"],"garrison":[{"unit":"militia","count":40},{"unit":"crossbow","count":16}]},{"id":3,"l":0,"t":"town","c":68,"r":62,"owner":0,"faction":"league","name":"Солеварск","tag":"solevarsk","built":["hall1","hall2","fort1","market","store","caravan","dwell1","dwell2","dwell3","dwell4"],"forbid":["hall4","altar","shipyard"],"garrison":[{"unit":"militia","count":36},{"unit":"ringer","count":10}]},{"id":4,"l":0,"t":"oremine","c":26,"r":66,"owner":-1},{"id":5,"l":0,"t":"sawmill","c":18,"r":50,"owner":-1},{"id":6,"l":0,"t":"goldmine","c":56,"r":62,"owner":-1},{"id":7,"l":0,"t":"saltworks","c":62,"r":44,"owner":-1},{"id":8,"l":0,"t":"sulfurspring","c":26,"r":42,"owner":-1},{"id":9,"l":0,"t":"monster","c":30,"r":54,"owner":-1,"unit":"militia","count":30,"max":90,"mood":"friendly"},{"id":10,"l":0,"t":"monster","c":12,"r":44,"owner":-1,"unit":"wolves","count":18,"max":54,"mood":"hostile"},{"id":11,"l":0,"t":"dwell-horseguard","c":50,"r":40,"owner":-1},{"id":12,"l":0,"t":"camp","c":28,"r":36,"owner":-1},{"id":13,"l":0,"t":"chapel","c":46,"r":58,"owner":-1},{"id":14,"l":0,"t":"res-gold","c":30,"r":40,"owner":-1},{"id":15,"l":0,"t":"res-gold","c":48,"r":34,"owner":-1},{"id":16,"l":0,"t":"res-gold","c":34,"r":62,"owner":-1},{"id":17,"l":0,"t":"res-gold","c":58,"r":50,"owner":-1},{"id":18,"l":0,"t":"res-gold","c":16,"r":56,"owner":-1},{"id":19,"l":0,"t":"res-ore","c":44,"r":60,"owner":-1},{"id":20,"l":0,"t":"res-ore","c":20,"r":44,"owner":-1},{"id":21,"l":0,"t":"res-wood","c":24,"r":52,"owner":-1},{"id":22,"l":0,"t":"res-wood","c":52,"r":44,"owner":-1},{"id":23,"l":0,"t":"res-sulfur","c":36,"r":26,"owner":-1},{"id":24,"l":0,"t":"res-sulfur","c":60,"r":50,"owner":-1},{"id":25,"l":0,"t":"res-salt","c":66,"r":50,"owner":-1},{"id":26,"l":0,"t":"res-salt","c":12,"r":60,"owner":-1},{"id":27,"l":0,"t":"campfire","c":32,"r":50,"owner":-1},{"id":28,"l":0,"t":"campfire","c":46,"r":50,"owner":-1},{"id":29,"l":0,"t":"artifact","c":6,"r":8,"owner":-1,"art":"bellcuirass"},{"id":30,"l":0,"t":"monster","c":8,"r":10,"owner":-1,"unit":"saltnoyon","count":4,"max":12,"mood":"fierce"},{"id":31,"l":0,"t":"signstone","c":44,"r":36,"owner":-1,"msg":"Торг закрыт по случаю конца света. Долги всё равно считаются."},{"id":32,"l":0,"t":"signstone","c":16,"r":62,"owner":-1,"msg":"До Звонграда два дня. До конца света, говорят, быстрее."},{"id":33,"l":0,"t":"tree","c":20,"r":62,"owner":-1},{"id":34,"l":0,"t":"tree","c":34,"r":34,"owner":-1},{"id":35,"l":0,"t":"tree","c":50,"r":66,"owner":-1},{"id":36,"l":0,"t":"tree","c":6,"r":40,"owner":-1},{"id":37,"l":0,"t":"tree","c":70,"r":70,"owner":-1},{"id":38,"l":0,"t":"pine","c":10,"r":28,"owner":-1},{"id":39,"l":0,"t":"pine","c":18,"r":34,"owner":-1},{"id":40,"l":0,"t":"pine","c":28,"r":12,"owner":-1},{"id":41,"l":0,"t":"pine","c":34,"r":16,"owner":-1},{"id":42,"l":0,"t":"rock","c":60,"r":34,"owner":-1},{"id":43,"l":0,"t":"rock","c":72,"r":20,"owner":-1},{"id":44,"l":0,"t":"rock","c":4,"r":76,"owner":-1},{"id":45,"l":0,"t":"rock","c":24,"r":8,"owner":-1},{"id":46,"l":0,"t":"mountain","c":72,"r":4,"owner":-1},{"id":47,"l":0,"t":"mountain","c":2,"r":2,"owner":-1}],"heroes":[{"owner":0,"hid":"adelina","c":40,"r":46,"l":0,"tag":"adelina","army":[{"unit":"pikeman","count":40},{"unit":"heavycrossbow","count":24},{"unit":"alarmist","count":10},{"unit":"plated","count":8},{"unit":"aeronaut","count":3}]},{"owner":1,"hid":"timar","c":74,"r":6,"l":0,"tag":"noyon","xp":9000,"army":[{"unit":"shade","count":80},{"unit":"horsebow","count":34},{"unit":"stonewoman","count":18},{"unit":"eaglespirit","count":10},{"unit":"saltnoyon","count":5},{"unit":"bonebull","count":3}]}],"events":[],"scenes":"event day 1 -> n5_start\nevent day 4 -> n5_wave1\nevent day 8 -> n5_wave2\nevent day 12 -> n5_wave3\nevent day 15 -> n5_held\nevent defeat noyon -> n5_won\nevent capture brod -> n5_brod\nevent capture solevarsk -> n5_soleva\nevent capture zvongrad -> n5_back\n\n@n5_start\nshow adelina left\nshow bellman right\nbellman: Набат, капитан?\nadelina: Набат.\nbellman: Вот теперь звоню так, как учили. Сорок лет ждал и лучше бы не дождался.\nhide bellman\nshow ortwin right\nortwin: Капитан, Литейная яма отдала одно орудие. Больше не успею.\nadelina: Бомбарда стреляет?\nortwin: Четыре раза. Потом можно ею подпереть ворота.\ngive unit bombard 1\nhide ortwin\nshow sergeant right\nsergeant: Брод и Солеварск ещё наши. Из них можно вести людей обозами.\nadelina: Сначала продержаться. Четырнадцать дней, пока подойдут все сёла.\ngoal add hold \"Удержать Звонград 14 дней\" stay zvongrad\ngoal add noyon \"Разбить нойона мёртвых\" to noyon\ngoal lose town zvongrad\naim player 1 zvongrad\nscene n5_size0\nsay Города и обозы теперь ваше войско. Кузня продаёт машины для боя: шатёр, стреломёт, повозка. В осаде башни и ров работают на вас.\nend\n\n@n5_wave1\nshow sergeant right\nsergeant: С востока ещё колонна. Идут к Броду.\nsergeant: И вот что, капитан. Взяли одного живого, если это можно так назвать. Тень с бляхой рода. Сидит в подвале Ратуши и молчит.\nadelina: Пусть сидит. Не трогать.\nspawn hero yesui 1 74 28 0 wave1\narmy wave1 shade 30 horsebow 18 stonewoman 8\nscene n5_size1\naim player 1 zvongrad brod\nend\n\n@n5_wave2\nshow sergeant right\nsergeant: С севера идут каменные. Медленно, но идут.\nspawn hero burtas 1 40 3 0 wave2\narmy wave2 stonewoman 10 eaglespirit 6 saltnoyon 2\nscene n5_size2\nend\n\n@n5_wave3\nshow sergeant right\nsergeant: Третья рать. Это всё, что у них есть, или мне так хочется думать.\nspawn hero ketebai 1 75 40 0 wave3\narmy wave3 horsebow 20 eaglespirit 8 saltnoyon 4 bonebull 2\nscene n5_size3\naim player 1 zvongrad solevarsk\nend\n\n@n5_held\nif owns zvongrad\nshow adelina left\nshow bellman right\nbellman: Четырнадцатый день. Сёла подошли, капитан. На стенах теперь тесно.\nadelina: Тогда хватит сидеть. Найдём нойона.\narmy zvongrad militia 200 crossbow 60 ringer 30 plated 14\nsay Ополчение сёл встало в гарнизон Звонграда. Город теперь держится сам, Аделина может идти за нойоном.\ngoal done hold\ngoal safe zvongrad\naim player 1 adelina\nend\nend\n\n@n5_size0\nif not diff easy\narmy noyon shade 30 horsebow 14 stonewoman 8 eaglespirit 4 saltnoyon 2 bonebull 1\nend\nif diff hard\narmy noyon shade 30 horsebow 14 stonewoman 8 eaglespirit 4 saltnoyon 2 bonebull 1\nend\nif diff impossible\narmy noyon shade 60 horsebow 28 stonewoman 16 eaglespirit 8 saltnoyon 4 bonebull 2\nend\nend\n\n@n5_size1\nif not diff easy\narmy wave1 shade 10 horsebow 6 stonewoman 2\nend\nif diff hard\narmy wave1 shade 10 horsebow 6 stonewoman 2\nend\nif diff impossible\narmy wave1 shade 20 horsebow 12 stonewoman 4\nend\nend\n\n@n5_size2\nif not diff easy\narmy wave2 stonewoman 4 eaglespirit 2 saltnoyon 1\nend\nif diff hard\narmy wave2 stonewoman 4 eaglespirit 2 saltnoyon 1\nend\nif diff impossible\narmy wave2 stonewoman 8 eaglespirit 4 saltnoyon 2\nend\nend\n\n@n5_size3\nif not diff easy\narmy wave3 horsebow 6 eaglespirit 2 saltnoyon 1 bonebull 1\nend\nif diff hard\narmy wave3 horsebow 6 eaglespirit 2 saltnoyon 1 bonebull 1\nend\nif diff impossible\narmy wave3 horsebow 12 eaglespirit 4 saltnoyon 2 bonebull 1\nend\nend\n\n@n5_brod\nsay Мельничный Брод снова ваш.\nend\n\n@n5_soleva\nsay Солеварск снова ваш.\nend\n\n@n5_back\nif flag noyon_down\ngoal done retake\nscene n5_final\nelse\nsay Звонград снова ваш.\nend\nend\n\n@n5_won\nset noyon_down\ngoal done noyon\nif owns zvongrad\nscene n5_final\nelse\nshow adelina left\nshow sergeant right\nsergeant: Нойон лёг, капитан. А над Ратушей всё ещё чужой бунчук.\nadelina: Значит, идём домой и снимаем его.\ngoal add retake \"Вернуть Звонград\" to zvongrad\nend\nend\n\n@n5_final\nshow adelina left\nshow sergeant right\nsergeant: Нойон лёг. Рать без него стоит и не знает, куда идти.\nadelina: Пленный ещё здесь?\nhide sergeant\nshow spirit right\nspirit: Я слышу колокол. Твой город стоит.\nadelina: Ты знаешь шаманку Айсулу?\nspirit: Её знают все, кто лежит в соли.\nadelina: Отнеси ей это. Письма бургомистра, с подписями и датой.\nspirit: Ты отпускаешь меня?\nadelina: Я отдаю долг, который не брала. Ваших разбудили за наши деньги. Она должна знать, с кого спрашивать.\nspirit: Живые так не делают.\nadelina: Иди, пока я считаю это разумным.\nkeep letters_sent\ngoal done hold\nwin\nend\n"}