{"game":"heroes98-map","v":1,"name":"Живая ветвь","about":"Пятая миссия кампании «Заповедь».","w":112,"h":112,"levels":1,"players":[{"who":"human","factions":["thicket"],"team":0,"town":1},{"who":"ai","factions":["thicket"],"team":1,"town":2}],"goals":{"win":[{"kind":"flag","flag":"n_never","text":"Выполнить задания миссии"}],"lose":[{"kind":"all"},{"kind":"hero","hid":"vedana"},{"kind":"town","town":1}]},"forbid":[],"heart":null,"next":49,"ter":[""],"road":[""],"river":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AMQ=="],"over":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AMQ=="],"objs":[{"id":1,"l":0,"t":"town","c":20,"r":54,"owner":0,"faction":"thicket","name":"Берёзовая Роща","tag":"grove","built":["hall1","hall2","hall3","fort1","fort2","tavern","market","smith","store","guild1","guild2","dwell1","dwell2","dwell3","dwell4","dwell5","dwell6","dwell1u","dwell2u","special1","special2"],"branch":{"1":"a","2":"a"},"forbid":["hall4","altar","shipyard"],"garrison":[{"unit":"mocker","count":60},{"unit":"elderwolf","count":24},{"unit":"bereginya","count":12}]},{"id":2,"l":0,"t":"town","c":92,"r":54,"owner":1,"faction":"thicket","name":"Старый бор","tag":"bor","built":["hall1","hall2","fort1","fort2","tavern","market","dwell1","dwell2","dwell3","dwell4","dwell5","dwell6"],"forbid":["hall4","altar","shipyard","dwell7"],"garrison":[{"unit":"auka","count":60},{"unit":"werewolf","count":20}]},{"id":3,"l":0,"t":"monster","c":60,"r":45,"owner":-1,"unit":"cityguard","count":20,"max":60,"mood":"fierce"},{"id":4,"l":0,"t":"monster","c":60,"r":67,"owner":-1,"unit":"cityguard","count":20,"max":60,"mood":"fierce"},{"id":5,"l":0,"t":"witchring","c":44,"r":30,"owner":0},{"id":6,"l":0,"t":"witchring","c":44,"r":84,"owner":0},{"id":7,"l":0,"t":"sawmill","c":8,"r":40,"owner":-1},{"id":8,"l":0,"t":"oremine","c":8,"r":72,"owner":-1},{"id":9,"l":0,"t":"ambermine","c":30,"r":30,"owner":-1},{"id":10,"l":0,"t":"monster","c":32,"r":32,"owner":-1,"unit":"bears","count":12,"max":36,"mood":"hostile"},{"id":11,"l":0,"t":"ambermine","c":30,"r":84,"owner":-1},{"id":12,"l":0,"t":"monster","c":32,"r":82,"owner":-1,"unit":"wolves","count":30,"max":90,"mood":"hostile"},{"id":13,"l":0,"t":"goldmine","c":44,"r":54,"owner":-1},{"id":14,"l":0,"t":"monster","c":44,"r":52,"owner":-1,"unit":"mercenaries","count":40,"max":120,"mood":"hostile"},{"id":15,"l":0,"t":"goldmine","c":12,"r":16,"owner":-1},{"id":16,"l":0,"t":"monster","c":14,"r":18,"owner":-1,"unit":"kikimora","count":14,"max":42,"mood":"hostile"},{"id":17,"l":0,"t":"res-gold","c":30,"r":48,"owner":-1},{"id":18,"l":0,"t":"res-gold","c":36,"r":66,"owner":-1},{"id":19,"l":0,"t":"res-gold","c":14,"r":66,"owner":-1},{"id":20,"l":0,"t":"res-gold","c":46,"r":70,"owner":-1},{"id":21,"l":0,"t":"res-gold","c":28,"r":20,"owner":-1},{"id":22,"l":0,"t":"res-gold","c":52,"r":46,"owner":-1},{"id":23,"l":0,"t":"res-gold","c":8,"r":92,"owner":-1},{"id":24,"l":0,"t":"res-gold","c":46,"r":92,"owner":-1},{"id":25,"l":0,"t":"res-amber","c":26,"r":70,"owner":-1},{"id":26,"l":0,"t":"res-amber","c":40,"r":40,"owner":-1},{"id":27,"l":0,"t":"res-amber","c":14,"r":30,"owner":-1},{"id":28,"l":0,"t":"res-wood","c":12,"r":48,"owner":-1},{"id":29,"l":0,"t":"res-wood","c":34,"r":74,"owner":-1},{"id":30,"l":0,"t":"res-ore","c":16,"r":78,"owner":-1},{"id":31,"l":0,"t":"res-ore","c":44,"r":40,"owner":-1},{"id":32,"l":0,"t":"campfire","c":34,"r":56,"owner":-1},{"id":33,"l":0,"t":"campfire","c":48,"r":60,"owner":-1},{"id":34,"l":0,"t":"campfire","c":24,"r":36,"owner":-1},{"id":35,"l":0,"t":"dwell-sirin","c":20,"r":90,"owner":-1},{"id":36,"l":0,"t":"monster","c":22,"r":88,"owner":-1,"unit":"sirin","count":6,"max":18,"mood":"fierce"},{"id":37,"l":0,"t":"dwell-leshy","c":8,"r":100,"owner":-1},{"id":38,"l":0,"t":"monster","c":12,"r":98,"owner":-1,"unit":"leshy","count":3,"max":9,"mood":"fierce"},{"id":39,"l":0,"t":"artifact","c":100,"r":100,"owner":-1,"art":"khanaxe"},{"id":40,"l":0,"t":"monster","c":98,"r":98,"owner":-1,"unit":"zmey","count":1,"max":3,"mood":"fierce"},{"id":41,"l":0,"t":"signstone","c":34,"r":52,"owner":-1,"text":"Священная берёза. Руками не трогать. Топором тем более."},{"id":42,"l":0,"t":"rock","c":20,"r":100,"owner":-1},{"id":43,"l":0,"t":"rock","c":70,"r":20,"owner":-1},{"id":44,"l":0,"t":"rock","c":80,"r":90,"owner":-1},{"id":45,"l":0,"t":"rock","c":40,"r":8,"owner":-1},{"id":46,"l":0,"t":"mountain","c":104,"r":4,"owner":-1},{"id":47,"l":0,"t":"mountain","c":4,"r":4,"owner":-1},{"id":48,"l":0,"t":"mountain","c":80,"r":40,"owner":-1}],"heroes":[{"owner":0,"hid":"vedana","c":22,"r":56,"l":0,"tag":"vedana","army":[{"unit":"mocker","count":90},{"unit":"elderwolf","count":50},{"unit":"keeper","count":24},{"unit":"kikimora","count":16},{"unit":"sirin","count":8},{"unit":"leshy","count":2}]},{"owner":1,"hid":"borovoy","c":94,"r":56,"l":0,"tag":"borovoy","xp":15000,"patrol":1,"army":[{"unit":"leshy","count":8},{"unit":"werewolf","count":60},{"unit":"kikimora","count":20},{"unit":"sirin","count":8}]}],"events":[],"scenes":"event day 1 -> z5_start\nevent day 6 -> z5_wave1\nevent day 13 -> z5_wave2\nevent day 20 -> z5_wave3\nevent day 22 -> z5_held\nevent defeat borovoy -> z5_beaten\nevent flag z5_end -> z5_final\n\n@z5_start\nshow vedana left\nshow yarina right\nyarina: Боровой идёт. С ним половина бора и люди в белом. Хочет к берёзе.\nvedana: Сколько нам держать?\nyarina: До новой луны ещё три недели. После неё лес проснётся весь, тогда и он не сунется.\ngoal add hold \"Удержать Священную берёзу 21 день или разбить Борового\" stay grove\nif kept snake_free\nshow zmey right\nzmey: Я тут. Пока что.\ngive unit zmey 1\nend\nif kept zap_paid\nshow adelina right\nadelina: Цехи получили своё, а я получила от них двадцать арбалетов. Распишись.\ngive unit crossbow 20\nend\nif kept zap_refused\nshow yarina right\nyarina: Цехи наняли ещё топоров. Они идут с первой волной.\nend\nif kept villages_kept\nsay Сёла Заречья прислали зерно и золото: они помнят, кто их не отдал.\ngive gold 4000\nend\naim player 1 grove\nsay Берёза стоит в вашем городе. Если город падёт, всё кончено. Волны придут с востока.\nend\n\n@z5_wave1\nspawn hero velimir 1 104 40 0 wave1\narmy wave1 werewolf 30 kikimora 8 sirin 2\nif kept zap_refused\narmy wave1 mercenaries 40\nend\nif not diff easy\narmy wave1 werewolf 20 kikimora 4\nend\nif diff hard\narmy wave1 werewolf 20 kikimora 4 sirin 2\nend\nif diff impossible\narmy wave1 werewolf 40 kikimora 8 sirin 4\nend\nsay С востока идёт первая волна.\nend\n\n@z5_wave2\nspawn hero gorazd 1 104 60 0 wave2\narmy wave2 werewolf 40 kikimora 14 sirin 4 leshy 2\nif not diff easy\narmy wave2 kikimora 6 sirin 2 leshy 1\nend\nif diff hard\narmy wave2 kikimora 6 sirin 2 leshy 1\nend\nif diff impossible\narmy wave2 kikimora 12 sirin 4 leshy 2\nend\nsay С востока идёт вторая волна. В ней лешие.\nend\n\n@z5_wave3\nspawn hero milava 1 104 80 0 wave3\narmy wave3 kikimora 20 sirin 8 leshy 4\nif not diff easy\narmy wave3 kikimora 8 sirin 4 leshy 2\nend\nif diff hard\narmy wave3 kikimora 8 sirin 4 leshy 2\nend\nif diff impossible\narmy wave3 kikimora 16 sirin 8 leshy 4\nend\nshow yarina right\nyarina: Третья. Большая. Это те, кто ещё вчера были нашими.\nend\n\n@z5_held\nshow yarina right\nyarina: Новая луна. Лес встал, чувствуешь?\ngoal done hold\nset z5_end\nend\n\n@z5_beaten\nshow borovoy right\nborovoy: Я помню этот лес без людей. Ты не помнишь.\nshow vedana left\nvedana: Я помню, что его можно выбрать ещё раз. Это и есть Грамота, старик.\ngoal done hold\nset z5_end\nend\n\n@z5_final\nshow vedana left\nshow cloak right\ncloak: Хорошо держалась, ведунья. Посмотри на север.\nvedana: Вижу. Вся роща в смоле.\ncloak: Один факел. Мы не жжём зря. Нам нужна только ветка.\nvedana: Живая ветвь держит лес с самой Грамоты.\ncloak: Тогда тебе решать, что ему держать дальше.\nif army zmey\nshow zmey right\nzmey: Скажи слово, и я съем этого человека. Потом придут другие, но будет приятно.\nkeep snake_alive\nshow cloak right\nend\nvedana: Закон, который сжигает рощу ради своей бумаги, мне не нужен. Возьми. И запомни: я приду за ней.\ncloak: Все так говорят.\nvedana: Не все держат слово шестьсот лет. Это записано.\nkeep branch_given\nwin\nend\n"}