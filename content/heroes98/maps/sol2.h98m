{"game":"heroes98-map","v":1,"name":"Белая корка","about":"Вторая миссия кампании «Соль».","w":80,"h":80,"levels":1,"players":[{"who":"human","factions":["barrows"],"team":0,"town":null}],"goals":{"win":[{"kind":"flag","flag":"n_never","text":"Выполнить задания миссии"}],"lose":[{"kind":"all"},{"kind":"hero","hid":"aisulu"}]},"forbid":[],"heart":null,"next":49,"ter":[""],"road":[""],"river":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AGQ=="],"over":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AGQ=="],"objs":[{"id":1,"l":0,"t":"kurganstone","c":58,"r":14,"owner":-1,"tag":"stone1"},{"id":2,"l":0,"t":"kurganstone","c":36,"r":36,"owner":-1},{"id":3,"l":0,"t":"kurganstone","c":30,"r":60,"owner":-1},{"id":4,"l":0,"t":"monster","c":51,"r":25,"owner":-1,"unit":"scorpions","count":14,"max":42,"mood":"fierce","tag":"salt1"},{"id":5,"l":0,"t":"monster","c":40,"r":41,"owner":-1,"unit":"horsebow","count":20,"max":60,"mood":"hostile"},{"id":6,"l":0,"t":"monster","c":25,"r":53,"owner":-1,"unit":"scorpions","count":24,"max":72,"mood":"fierce"},{"id":7,"l":0,"t":"monster","c":66,"r":53,"owner":-1,"unit":"bandits","count":44,"max":132,"mood":"hostile"},{"id":8,"l":0,"t":"monster","c":10,"r":27,"owner":-1,"unit":"wolves","count":24,"max":72,"mood":"hostile"},{"id":9,"l":0,"t":"monster","c":12,"r":67,"owner":-1,"unit":"crossbow","count":30,"max":90,"mood":"hostile"},{"id":10,"l":0,"t":"signstone","c":18,"r":62,"owner":-1,"tag":"tracks","text":"Колея свежая. Узкие колёса с железом, белая пыль."},{"id":11,"l":0,"t":"signstone","c":6,"r":72,"owner":-1,"tag":"exit","text":"Край Белой корки."},{"id":12,"l":0,"t":"dwell-shade","c":66,"r":22,"owner":-1},{"id":13,"l":0,"t":"dwell-horsebow","c":44,"r":34,"owner":-1},{"id":14,"l":0,"t":"dwell-stonewoman","c":34,"r":64,"owner":-1},{"id":15,"l":0,"t":"well","c":60,"r":10,"owner":-1},{"id":16,"l":0,"t":"well","c":42,"r":46,"owner":-1},{"id":17,"l":0,"t":"well","c":22,"r":66,"owner":-1},{"id":18,"l":0,"t":"saltworks","c":70,"r":40,"owner":-1},{"id":19,"l":0,"t":"monster","c":70,"r":38,"owner":-1,"unit":"stonewoman","count":7,"max":21,"mood":"hostile"},{"id":20,"l":0,"t":"res-gold","c":72,"r":18,"owner":-1},{"id":21,"l":0,"t":"res-gold","c":60,"r":32,"owner":-1},{"id":22,"l":0,"t":"res-gold","c":46,"r":42,"owner":-1},{"id":23,"l":0,"t":"res-gold","c":30,"r":44,"owner":-1},{"id":24,"l":0,"t":"res-gold","c":38,"r":58,"owner":-1},{"id":25,"l":0,"t":"res-gold","c":14,"r":62,"owner":-1},{"id":26,"l":0,"t":"res-gold","c":54,"r":12,"owner":-1},{"id":27,"l":0,"t":"res-gold","c":74,"r":30,"owner":-1},{"id":28,"l":0,"t":"res-salt","c":50,"r":18,"owner":-1},{"id":29,"l":0,"t":"res-salt","c":66,"r":30,"owner":-1},{"id":30,"l":0,"t":"res-salt","c":28,"r":40,"owner":-1},{"id":31,"l":0,"t":"res-salt","c":44,"r":56,"owner":-1},{"id":32,"l":0,"t":"campfire","c":62,"r":12,"owner":-1},{"id":33,"l":0,"t":"campfire","c":48,"r":38,"owner":-1},{"id":34,"l":0,"t":"campfire","c":28,"r":56,"owner":-1},{"id":35,"l":0,"t":"chest","c":72,"r":66,"owner":-1,"offer":2},{"id":36,"l":0,"t":"monster","c":70,"r":64,"owner":-1,"unit":"saltnoyon","count":3,"max":9,"mood":"hostile"},{"id":37,"l":0,"t":"artifact","c":6,"r":40,"owner":-1,"art":"saltstaff"},{"id":38,"l":0,"t":"monster","c":8,"r":42,"owner":-1,"unit":"stonewoman","count":9,"max":27,"mood":"fierce"},{"id":39,"l":0,"t":"signstone","c":66,"r":10,"owner":-1,"text":"Белая корка. Воды нет. Если вы мертвы, это не ваша забота."},{"id":40,"l":0,"t":"signstone","c":52,"r":28,"owner":-1,"text":"Соль здесь не покупают. Соль здесь покупает вас."},{"id":41,"l":0,"t":"rock","c":64,"r":34,"owner":-1},{"id":42,"l":0,"t":"rock","c":44,"r":12,"owner":-1},{"id":43,"l":0,"t":"rock","c":20,"r":44,"owner":-1},{"id":44,"l":0,"t":"rock","c":12,"r":56,"owner":-1},{"id":45,"l":0,"t":"rock","c":68,"r":58,"owner":-1},{"id":46,"l":0,"t":"rock","c":50,"r":70,"owner":-1},{"id":47,"l":0,"t":"mountain","c":4,"r":4,"owner":-1},{"id":48,"l":0,"t":"mountain","c":72,"r":72,"owner":-1}],"heroes":[{"owner":0,"hid":"aisulu","c":70,"r":10,"l":0,"tag":"aisulu","army":[{"unit":"shade","count":50},{"unit":"horsebow","count":18},{"unit":"stonewoman","count":6}]}],"events":[],"scenes":"event day 1 -> s2_start\nevent visit stone1 -> s2_stone\nevent visit tracks -> s2_tracks\nevent visit exit -> s2_exit\nevent defeat salt1 -> s2_salt1\nevent day 8 -> s2_week\n\n@s2_start\nshow aisulu left\nshow yesui right\nyesui: Здесь никто не ходит рядом с тобой, шаманка. Только мы.\naisulu: Я знаю. Дойдём до края корки?\nyesui: Мёртвые дойдут. Вопрос, сколько мёртвых. Соль здесь режет даже нас.\ngoal add exit \"Вывести рать через солончак к западному краю\" to exit\nsay Своего города здесь нет. Павшие бродят за вами. Поднять их можно у курганных камней: раз в неделю, за половину цены, прямо в войско.\nend\n\n@s2_stone\nshow aisulu left\nshow yesui right\nyesui: Этот камень старше курганов. Спроси его про своих.\naisulu: Кого он вернёт?\nyesui: Тех, кто ещё помнит, куда шёл.\nend\n\n@s2_salt1\nshow aisulu left\nshow yesui right\nyesui: Скорпионы сидели на дороге, как таможня. Кто-то их потревожил до нас.\naisulu: Кто здесь ходит?\nyesui: Посмотри на следы, когда дойдём до стоянки. Степь таких не оставляет.\nend\n\n@s2_week\nshow yesui right\nyesui: Ещё неделя, и я перестала считать, кто за мной идёт.\nend\n\n@s2_tracks\nshow aisulu left\nshow yesui right\naisulu: Колёса, узкие, с железом. Белая пыль на краю колеи, не наша соль. Лунная.\nyesui: На такой дороге не ездили тысячу лет.\naisulu: Кто-то её расчистил. Смотри, куда ведут.\nset tracks_seen\nend\n\n@s2_exit\nshow aisulu left\nshow yesui right\nif flag tracks_seen\nyesui: Край корки. Дальше дорога, и она светится сама.\nelse\naisulu: Стой. Смотри на землю. Колёса, узкие, с железом, и белая пыль в колее.\nyesui: На такой дороге не ездили тысячу лет. Дальше она светится сама.\nend\naisulu: Значит, венец ушёл по ней. Куда?\nyesui: Спроси живых. Мёртвые туда не смотрят.\naisulu: Сначала нужны роды. Без родов мне не поверят, а без веры я только девочка с бубном.\ngoal done exit\nwin\nend\n"}