{"game":"heroes98-map","v":1,"name":"Соляной путь","about":"Третья миссия кампании «Набат».","w":80,"h":80,"levels":1,"players":[{"who":"human","factions":["league"],"team":0,"town":1}],"goals":{"win":[{"kind":"flag","flag":"n_never","text":"Выполнить задания миссии"}],"lose":[{"kind":"all"},{"kind":"hero","hid":"adelina"}]},"forbid":[],"heart":null,"next":72,"ter":[""],"road":[""],"river":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AGQ=="],"over":["AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8AGQ=="],"objs":[{"id":1,"l":0,"t":"town","c":7,"r":60,"owner":0,"faction":"league","name":"Мельничный Брод","tag":"brod","built":["hall1","hall2","fort1","tavern","market","dwell1","dwell2","dwell3","smith","guild1"],"forbid":["hall4","dwell7","dwell7u","altar","shipyard","guild5"]},{"id":2,"l":0,"t":"town","c":64,"r":13,"owner":0,"faction":"league","name":"Солеварск","tag":"solevarsk","built":["hall1","fort1","market","store","caravan","dwell1"],"forbid":["hall4","dwell7","dwell7u","altar","shipyard","guild5"]},{"id":3,"l":0,"t":"monster","c":35,"r":46,"owner":-1,"unit":"bandits","count":28,"max":84,"mood":"fierce","tag":"ford1"},{"id":4,"l":0,"t":"monster","c":36,"r":16,"owner":-1,"unit":"shade","count":30,"max":90,"mood":"fierce","tag":"ford2"},{"id":5,"l":0,"t":"monster","c":49,"r":33,"owner":-1,"unit":"bandits","count":34,"max":102,"mood":"fierce"},{"id":6,"l":0,"t":"monster","c":59,"r":21,"owner":-1,"unit":"horsebow","count":12,"max":36,"mood":"hostile"},{"id":7,"l":0,"t":"sawmill","c":3,"r":54,"owner":-1},{"id":8,"l":0,"t":"oremine","c":14,"r":73,"owner":-1},{"id":9,"l":0,"t":"goldmine","c":24,"r":72,"owner":-1},{"id":10,"l":0,"t":"monster","c":28,"r":75,"owner":-1,"unit":"militia","count":22,"max":66,"mood":"cautious"},{"id":11,"l":0,"t":"saltworks","c":72,"r":18,"owner":-1},{"id":12,"l":0,"t":"monster","c":72,"r":22,"owner":-1,"unit":"stonewoman","count":7,"max":21,"mood":"hostile"},{"id":13,"l":0,"t":"sulfurspring","c":66,"r":70,"owner":-1},{"id":14,"l":0,"t":"monster","c":64,"r":68,"owner":-1,"unit":"shade","count":26,"max":78,"mood":"hostile"},{"id":15,"l":0,"t":"goldmine","c":56,"r":8,"owner":-1},{"id":16,"l":0,"t":"monster","c":56,"r":12,"owner":-1,"unit":"horsebow","count":16,"max":48,"mood":"hostile"},{"id":17,"l":0,"t":"signstone","c":58,"r":30,"owner":-1,"msg":"В пепле полынь. Кто-то жёг её не для тепла, а чтобы дым шёл прямо вверх."},{"id":18,"l":0,"t":"signstone","c":58,"r":27,"owner":-1,"tag":"camp"},{"id":19,"l":0,"t":"kurganstone","c":72,"r":4,"owner":-1,"tag":"kurgan"},{"id":20,"l":0,"t":"monster","c":71,"r":8,"owner":-1,"unit":"stonewoman","count":10,"max":30,"mood":"fierce"},{"id":21,"l":0,"t":"wolfden","c":14,"r":18,"owner":-1},{"id":22,"l":0,"t":"watchtower","c":30,"r":40,"owner":-1},{"id":23,"l":0,"t":"camp","c":20,"r":50,"owner":-1},{"id":24,"l":0,"t":"apiary","c":44,"r":22,"owner":-1},{"id":25,"l":0,"t":"stable","c":58,"r":60,"owner":-1},{"id":26,"l":0,"t":"chapel","c":46,"r":44,"owner":-1},{"id":27,"l":0,"t":"inn","c":40,"r":8,"owner":-1},{"id":28,"l":0,"t":"shrine1","c":26,"r":56,"owner":-1,"spell":"balm"},{"id":29,"l":0,"t":"shrine2","c":50,"r":26,"owner":-1,"spell":"stoneskin"},{"id":30,"l":0,"t":"res-gold","c":20,"r":62,"owner":-1},{"id":31,"l":0,"t":"res-gold","c":30,"r":30,"owner":-1},{"id":32,"l":0,"t":"res-gold","c":52,"r":18,"owner":-1},{"id":33,"l":0,"t":"res-gold","c":62,"r":44,"owner":-1},{"id":34,"l":0,"t":"res-gold","c":70,"r":30,"owner":-1},{"id":35,"l":0,"t":"res-wood","c":5,"r":70,"owner":-1},{"id":36,"l":0,"t":"res-wood","c":28,"r":12,"owner":-1},{"id":37,"l":0,"t":"res-wood","c":46,"r":60,"owner":-1},{"id":38,"l":0,"t":"res-ore","c":16,"r":50,"owner":-1},{"id":39,"l":0,"t":"res-ore","c":52,"r":40,"owner":-1},{"id":40,"l":0,"t":"res-ore","c":74,"r":44,"owner":-1},{"id":41,"l":0,"t":"res-salt","c":66,"r":36,"owner":-1},{"id":42,"l":0,"t":"res-salt","c":60,"r":30,"owner":-1},{"id":43,"l":0,"t":"res-salt","c":72,"r":70,"owner":-1},{"id":44,"l":0,"t":"res-sulfur","c":34,"r":66,"owner":-1},{"id":45,"l":0,"t":"res-sulfur","c":66,"r":64,"owner":-1},{"id":46,"l":0,"t":"campfire","c":22,"r":44,"owner":-1},{"id":47,"l":0,"t":"campfire","c":44,"r":36,"owner":-1},{"id":48,"l":0,"t":"campfire","c":60,"r":12,"owner":-1},{"id":49,"l":0,"t":"chest","c":8,"r":8,"owner":-1,"offer":2},{"id":50,"l":0,"t":"monster","c":12,"r":9,"owner":-1,"unit":"wolves","count":20,"max":60,"mood":"hostile"},{"id":51,"l":0,"t":"artifact","c":74,"r":74,"owner":-1,"art":"saltcharm"},{"id":52,"l":0,"t":"monster","c":73,"r":72,"owner":-1,"unit":"saltnoyon","count":3,"max":9,"mood":"fierce"},{"id":53,"l":0,"t":"signstone","c":25,"r":46,"owner":-1,"msg":"Соляной путь. За порчу подводы штраф. За порчу возчика штраф поменьше."},{"id":54,"l":0,"t":"tree","c":10,"r":50,"owner":-1},{"id":55,"l":0,"t":"tree","c":24,"r":64,"owner":-1},{"id":56,"l":0,"t":"tree","c":40,"r":54,"owner":-1},{"id":57,"l":0,"t":"tree","c":44,"r":70,"owner":-1},{"id":58,"l":0,"t":"tree","c":6,"r":30,"owner":-1},{"id":59,"l":0,"t":"tree","c":28,"r":6,"owner":-1},{"id":60,"l":0,"t":"pine","c":14,"r":38,"owner":-1},{"id":61,"l":0,"t":"pine","c":20,"r":42,"owner":-1},{"id":62,"l":0,"t":"pine","c":10,"r":12,"owner":-1},{"id":63,"l":0,"t":"pine","c":16,"r":8,"owner":-1},{"id":64,"l":0,"t":"pine","c":50,"r":68,"owner":-1},{"id":65,"l":0,"t":"rock","c":62,"r":42,"owner":-1},{"id":66,"l":0,"t":"rock","c":74,"r":26,"owner":-1},{"id":67,"l":0,"t":"rock","c":60,"r":8,"owner":-1},{"id":68,"l":0,"t":"rock","c":48,"r":6,"owner":-1},{"id":69,"l":0,"t":"rock","c":70,"r":60,"owner":-1},{"id":70,"l":0,"t":"mountain","c":76,"r":76,"owner":-1},{"id":71,"l":0,"t":"mountain","c":2,"r":2,"owner":-1}],"heroes":[{"owner":0,"hid":"adelina","c":9,"r":62,"l":0,"tag":"adelina","army":[{"unit":"militia","count":40},{"unit":"crossbow","count":16},{"unit":"ringer","count":6}]}],"events":[],"scenes":"event day 1 -> n3_start\nevent heroes 2 -> n3_second\nevent caravan solevarsk repeat -> n3_salt\nevent visit camp -> n3_camp\nevent defeat ambush -> n3_after\nevent visit kurgan repeat -> n3_kurgan\nevent flag n3_all -> n3_win\n\n@n3_start\nshow adelina left\nshow mirabel right\nmirabel: Капитан Корвен, я веду книги Солеварска. Три обоза сырца стоят в Броду, а варницы пустуют четвёртую неделю.\nadelina: Что мешает?\nmirabel: Разбойники на дороге, мёртвые за дорогой и наш бургомистр, который не подписывает охрану.\nadelina: Мальс?\nmirabel: Он. Я не спрашиваю почему. Я только считаю, сколько это стоит. Без соли цех не заплатит ополчению.\nadelina: Сколько обозов нужно?\nmirabel: Три. Каждый обоз принесёт золото и соль.\ngoal add salt \"Провести три обоза в Солеварск\" to solevarsk ford1 ford2\ngoal add second \"Нанять второго героя в таверне\"\ngoal add camp \"Найти шаманку, о которой говорят на тракте\" to camp\nsay Обоз идёт сам, но только по чистой дороге: отряды на пути его не пропустят. Откройте Солеварск, Обозная станция, и выберите, откуда идти.\nend\n\n@n3_second\nsay Второй герой поведёт своё войско. Рядом стоящие герои меняются отрядами и вещами: щёлкните по герою, стоящему рядом.\ngoal done second\nset second_done\nscene n3_check\nend\n\n@n3_salt\nif flag salt2\nset salt3\nsay Третий обоз в Солеварске.\ngive gold 1500\ngive salt 2\ngoal done salt\nscene n3_check\nelse\nif flag salt1\nset salt2\nsay Второй обоз в Солеварске. Остался один.\ngive gold 1500\ngive salt 2\nelse\nset salt1\nsay Первый обоз в Солеварске. Осталось два.\ngive gold 1500\ngive salt 2\nend\nend\nend\n\n@n3_camp\nshow adelina left\nshow aisulu right\naisulu: Не подходи с той стороны, там ветер. Ты с колоколами?\nadelina: Капитан стражи Звонграда. На ваших людях свежая соль.\naisulu: Они не мои. Они ничьи теперь. Я спрашивала. Они не знают, кто их поднял, но все идут сюда, на запад.\nadelina: Кто вскрыл курган?\naisulu: Те, кто в белом. Унесли Солевой венец. Без него хан не лежит.\nshow sergeant left\nsergeant: Капитан, на дороге люди. Там наши. Наши щиты, наше знамя.\naisulu: Посмотри на их ноги. У них нет теней.\nhide sergeant\nshow adelina left\nshow cloak right\ncloak: Капитан Корвен. Вы далеко от своих колоколов.\nadelina: Кто вы?\ncloak: Никто, с кем стоит воевать. Нам нужна шаманка, остальных мы не держим.\nadelina: Откуда у вас моё войско?\ncloak: Это отражение. Оно ничего не весит, пока вы сами его не испугаетесь. Отойдите, капитан. Мы заняты тем, что спасёт и вашу дельту.\nspawn hero aisulu 0 57 26 0 aisulu\nspawn mirror 0.5 56 22 0 ambush\nreveal 56 22 4\ngoal done camp\ngoal add ambush \"Разбить отражения\" to ambush\nsay Отражение повторяет ваш самый сильный отряд. Айсулу теперь с вами: это второй герой, ходите им как обычно.\nend\n\n@n3_after\nshow adelina left\nshow aisulu right\naisulu: Они рассыпались, как соль в воде.\nadelina: А тот, в белом?\naisulu: Ушёл раньше, чем они упали. Он знал, чем кончится.\naisulu: Мне нужно к кургану на северо-востоке. Предки там говорят яснее. Можешь не провожать.\nadelina: Йорис, это Лига теперь спорит с Орденом?\nshow sergeant right\nsergeant: Спорить будем потом, капитан. Сначала обозы.\ngoal done ambush\ngoal add kurgan \"Необязательно: довести Айсулу до кургана\" to kurgan\nset ambush_done\nscene n3_check\nend\n\n@n3_kurgan\nif hero aisulu\nshow aisulu left\naisulu: Здесь. Я слышу их.\naisulu: Хан встал без венца и зовёт род на дельту. Я пойду за венцом, а ты разбирайся со своими.\naisulu: Если придётся выбирать между дельтой и степью, я выберу тех, кто молчит. Запомни это, капитан.\ngoal done kurgan\nkeep aisulu_led\nelse\nsay Курган молчит. Камень холодный, говорить с ним может только шаманка.\nend\nend\n\n@n3_check\nif flag second_done\nif flag ambush_done\nif flag salt3\nset n3_all\nend\nend\nend\nend\n\n@n3_win\nshow adelina left\nshow mirabel right\nmirabel: Три обоза, цех заплатил. Это первое ваше дело, которое сошлось с моими книгами.\nadelina: А подпись Мальса?\nmirabel: Об этом я хотела поговорить в Звонграде. Не при людях. Я нашла ещё кое-что в счетах Ратуши.\nwin\nend\n"}