ll4","altar","shipyard","dwell1","dwell2","dwell3","dwell4","dwell5","dwell6","dwell7","hall2"],"garrison":[{"unit":"pikeman","count":80},{"unit":"heavycrossbow","count":30},{"unit":"plated","count":12},{"unit":"aeronaut","count":4}]},{"id":5,"l":0,"t":"hamlet","c":50,"r":84,"owner":-1,"tag":"v1","gold":1500},{"id":6,"l":0,"t":"hamlet","c":38,"r":76,"owner":-1,"tag":"v2","gold":1500},{"id":7,"l":0,"t":"hamlet","c":50,"r":70,"owner":-1,"tag":"v3","gold":1500},{"id":8,"l":0,"t":"hamlet","c":28,"r":66,"owner":-1,"tag":"v4","gold":1500},{"id":9,"l":0,"t":"monster","c":58,"r":88,"owner":-1,"unit":"halberdier","count":28,"max":84,"mood":"fierce"},{"id":10,"l":0,"t":"monster","c":46,"r":80,"owner":-1,"unit":"crossbow","count":60,"max":180,"mood":"hostile"},{"id":11,"l":0,"t":"monster","c":44,"r":66,"owner":-1,"unit":"cityguard","count":20,"max":60,"mood":"hostile"},{"id":12,"l":0,"t":"monster","c":58,"r":22,"owner":-1,"unit":"halberdier","count":20,"max":60,"mood":"fierce"},{"id":13,"l":0,"t":"kurganstone","c":74,"r":76,"owner":-1},{"id":14,"l":0,"t":"kurganstone","c":70,"r":92,"owner":-1},{"id":15,"l":0,"t":"sawmill","c":102,"r":96,"owner":-1},{"id":16,"l":0,"t":"oremine","c":80,"r":100,"owner":-1},{"id":17,"l":0,"t":"saltworks","c":76,"r":54,"owner":-1},{"id":18,"l":0,"t":"monster","c":76,"r":56,"owner":-1,"unit":"scorpions","count":30,"max":90,"mood":"hostile"},{"id":19,"l":0,"t":"goldmine","c":102,"r":66,"owner":-1},{"id":20,"l":0,"t":"monster","c":102,"r":68,"owner":-1,"unit":"wolves","count":40,"max":120,"mood":"hostile"},{"id":21,"l":0,"t":"goldmine","c":70,"r":104,"owner":-1},{"id":22,"l":0,"t":"monster","c":68,"r":102,"owner":-1,"unit":"stonewoman","count":16,"max":48,"mood":"hostile"},{"id":23,"l":0,"t":"sulfurspring","c":22,"r":86,"owner":-1},{"id":24,"l":0,"t":"monster","c":24,"r":88,"owner":-1,"unit":"mercenaries","count":40,"max":120,"mood":"hostile"},{"id":25,"l":0,"t":"saltworks","c":44,"r":96,"owner":-1},{"id":26,"l":0,"t":"monster","c":46,"r":94,"owner":-1,"unit":"bandits","count":80,"max":240,"mood":"hostile"},{"id":27,"l":0,"t":"res-gold","c":84,"r":80,"owner":-1},{"id":28,"l":0,"t":"res-gold","c":64,"r":92,"owner":-1},{"id":29,"l":0,"t":"res-gold","c":76,"r":70,"owner":-1},{"id":30,"l":0,"t":"res-gold","c":66,"r":80,"owner":-1},{"id":31,"l":0,"t":"res-gold","c":96,"r":74,"owner":-1},{"id":32,"l":0,"t":"res-gold","c":52,"r":92,"owner":-1},{"id":33,"l":0,"t":"res-gold","c":42,"r":88,"owner":-1},{"id":34,"l":0,"t":"res-gold","c":30,"r":72,"owner":-1},{"id":35,"l":0,"t":"res-salt","c":86,"r":66,"owner":-1},{"id":36,"l":0,"t":"res-salt","c":72,"r":84,"owner":-1},{"id":37,"l":0,"t":"res-salt","c":36,"r":92,"owner":-1},{"id":38,"l":0,"t":"res-ore","c":86,"r":94,"owner":-1},{"id":39,"l":0,"t":"res-ore","c":72,"r":62,"owner":-1},{"id":40,"l":0,"t":"res-wood","c":98,"r":92,"owner":-1},{"id":41,"l":0,"t":"res-wood","c":62,"r":72,"owner":-1},{"id":42,"l":0,"t":"campfire","c":82,"r":92,"owner":-1},{"id":43,"l":0,"t":"campfire","c":64,"r":84,"owner":-1},{"id":44,"l":0,"t":"campfire","c":42,"r":72,"owner":-1},{"id":45,"l":0,"t":"monster","c":72,"r":42,"owner":-1,"unit":"horsebow","count":30,"max":90,"mood":"hostile"},{"id":46,"l":0,"t":"dwell-eaglespirit","c":76,"r":34,"owner":-1},{"id":47,"l":0,"t":"dwell-bonebull","c":66,"r":70,"owner":-1},{"id":48,"l":0,"t":"monster","c":66,"r":68,"owner":-1,"unit":"bonebull","count":6,"max":18,"mood":"fierce"},{"id":49,"l":0,"t":"artifact","c":6,"r":104,"owner":-1,"art":"khanaxe"},{"id":50,"l":0,"t":"monster","c":8,"r":102,"owner":-1,"unit":"stonekhan","count":2,"max":6,"mood":"fierce"},{"id":51,"l":0,"t":"signstone","c":62,"r":86,"owner":-1,"text":"Южный перевал. Проход по грамоте, пошлина соляная, спор решает комендант."},{"id":52,"l":0,"t":"signstone","c":52,"r":80,"owner":-1,"text":"Здесь живут люди. Они ничего не вскрывали."},{"id":53,"l":0,"t":"rock","c":66,"r":26,"owner":-1},{"id":54,"l":0,"t":"rock","c":100,"r":40,"owner":-1},{"id":55,"l":0,"t":"rock","c":80,"r":96,"owner":-1},{"id":56,"l":0,"t":"rock","c":46,"r":104,"owner":-1},{"id":57,"l":0,"t":"rock","c":14,"r":50,"owner":-1},{"id":58,"l":0,"t":"mountain","c":104,"r":4,"owner":-1},{"id":59,"l":0,"t":"mountain","c":4,"r":92,"owner":-1},{"id":60,"l":0,"t":"mountain","c":66,"r":50,"owner":-1}],"heroes":[{"owner":0,"hid":"aisulu","c":94,"r":88,"l":0,"tag":"aisulu","army":[{"unit":"mourner","count":60},{"unit":"steppearcher","count":30},{"unit":"stonewoman","count":16},{"unit":"eaglespirit","count":12},{"unit":"saltnoyon","count":6}]},{"owner":1,"hid":"kaidar","c":94,"r":20,"l":0,"tag":"kaidar","xp":20000,"army":[{"unit":"shade","count":90},{"unit":"horsebow","count":40},{"unit":"stonewoman","count":20},{"unit":"bonebull","count":6},{"unit":"stonekhan","count":2}]},{"owner":2,"hid":"renier","c":38,"r":58,"l":0,"tag":"renier","xp":15000,"patrol":1,"army":[{"unit":"cityguard","count":20},{"unit":"heavycrossbow","count":20},{"unit":"plated","count":10},{"unit":"cuirassier","count":2}]},{"owner":2,"hid":"ortwin","c":16,"r":24,"l":0,"tag":"ortwin","xp":15000,"patrol":3,"army":[{"unit":"pikeman","count":20},{"unit":"heavycrossbow","count":12},{"unit":"alarmist","count":6},{"unit":"plated","count":3},{"unit":"aeronaut","count":1}]}],"events":[],"scenes":"event day 1 -> s5_start\nevent capture fort -> s5_fort\nevent capture fort player 1 -> s5_khan_fort\nevent capture rechnoy player 1 -> s5_rechnoy\nevent defeat kaidar -> s5_khan_down\nevent done v1 -> s5_touch\nevent done v2 -> s5_touch\nevent done v3 -> s5_touch\nevent done v4 -> s5_touch\nevent day 10 -> s5_khan\n\n@s5_start\nshow aisulu left\nshow kaidar right\nkaidar: Ты вернулась без венца.\naisulu: Он в Чаше, на белом корабле. Я знаю, кто его увёз и кто заплатил.\nkaidar: Кто заплатил, того и резать. Лига стоит на нашей соли. Я иду на Речной Стан.\naisulu: В Межевом форте капитан с письмами. Сожжёшь форт, сгорят и письма.\nkaidar: Письма. Я лежал сто тридцать лет, чтобы мне читали письма.\naisulu: Лежал бы дальше, если бы не они. Иди северным перевалом, а форт оставь мне.\ngoal add fort \"Взять Межевой форт через южный перевал\" to fort\ngoal add spare \"Необязательно: не разорить ни одного села\"\nif kept promised_guilty\nshow erden right\nerden: Роды прислали камни. Ты обещала виновных, мы пришли посмотреть.\ngive unit stonewoman 12\nelse\nshow erden right\nerden: Роды дают тебе три месяца и ни камня больше. Зато золото твоё, купи кого хочешь.\ngive gold 3000\nend\naim player 1 rechnoy\naim player 2 kaidar\nsay Кайдар-хан ваш союзник: его войско идёт само, его города и шахты вы не занимаете. Сёла можно разорить ради золота или пройти мимо.\nend\n\n@s5_touch\nif not flag touched\nshow aisulu left\naisulu: Здесь жили те, кто ничего не вскрывал.\nset touched\ngoal fail spare\nend\nend\n\n@s5_khan\nshow kaidar right\nkaidar: Твои живые медлят. Мёртвые не устают, шаманка, но они и не ждут.\nend\n\n@s5_rechnoy\nsay Речной Стан горит. Рать Кайдар-хана не берёт пленных и не читает писем.\nshow kaidar right\nkaidar: Следующий форт, шаманка. Успей раньше меня, если тебе так нужна бумага.\naim player 1 fort\nset rechnoy_burned\nend\n\n@s5_khan_down\nsay Рать Кайдар-хана разбита у чужих стен. Сам хан снова в земле и встанет не скоро. Теперь на этой войне только вы.\nset khan_fell\nend\n\n@s5_khan_fort\nset khan_took\nflag fort 0\nend\n\n@s5_fort\nshow aisulu left\nif flag khan_took\nshow kaidar right\nkaidar: Форт мой. Точнее, то, что от него осталось. Забирай свою бумагу, пока не догорела.\naisulu: Половины здесь нет.\nkaidar: Половины здесь нет с той весны, как унесли мой венец.\nkeep letters_half\nend\nshow adelina right\nadelina: Опусти бунчук, шаманка. Стрелять здесь больше некому.\naisulu: Твой дух дошёл. Вот письма Мальса, а вот что нашла я: белые повозки, лунная дорога, белый корабль.\nadelina: Мальс уехал с белыми плащами. И венец, значит, с ними.\naisulu: Венец в Чаше. Кто платил, знаешь ты. Кто вскрыл курган, теперь знаю я.\nadelina: Тогда мы обе воевали не с теми.\nhide adelina\nshow kaidar right\nif flag khan_fell\nkaidar: Мою рать положили, а я опять стою. Где тот, кто заплатил?\nelse\nkaidar: Где тот, кто заплатил?\nend\naisulu: Уехал к тем, кто забрал твой венец. Хан, он в Чаше. Мёртвые туда не дойдут.\nkaidar: Я ждал сто тридцать лет не для того, чтобы услышать от девочки, что мне не дойти.\naisulu: Ложись. Я дойду. Отдай мне рать.\nkaidar: Ты не хан.\naisulu: Нет. Я та, кто спрашивает.\nkaidar: Тогда спроси с них за меня.\nif not flag touched\nsay Ни одно село не разорено. В дельте это заметят.\nkeep spared_villages\ngoal done spare\nend\nkeep kaidar_host\ngoal done fort\nwin\nend\n"}