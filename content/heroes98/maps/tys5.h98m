nit":"moonarcher","count":20}]},{"id":2,"l":0,"t":"whiteruin","c":71,"r":12,"owner":1,"tag":"alt1"},{"id":3,"l":0,"t":"whiteruin","c":71,"r":128,"owner":1,"tag":"alt2"},{"id":4,"l":0,"t":"monster","c":73,"r":14,"owner":-1,"unit":"mirrorguard","count":30,"max":90,"mood":"fierce"},{"id":5,"l":0,"t":"monster","c":73,"r":130,"owner":-1,"unit":"moonarcher","count":40,"max":120,"mood":"fierce"},{"id":6,"l":0,"t":"monster","c":58,"r":72,"owner":-1,"unit":"moondream","count":40,"max":120,"mood":"fierce","tag":"ward"},{"id":7,"l":0,"t":"stairsdown","c":46,"r":66,"owner":-1,"tag":"down","link":8},{"id":8,"l":1,"t":"stairsup","c":46,"r":66,"owner":-1,"link":7},{"id":9,"l":1,"t":"chapel","c":72,"r":70,"owner":-1,"tag":"song"},{"id":10,"l":1,"t":"monster","c":62,"r":72,"owner":-1,"unit":"silverspirit","count":8,"max":24,"mood":"fierce"},{"id":11,"l":1,"t":"res-moonsilver","c":52,"r":70,"owner":-1},{"id":12,"l":1,"t":"res-moonsilver","c":66,"r":74,"owner":-1},{"id":13,"l":1,"t":"signstone","c":70,"r":75,"owner":-1,"text":"Храм первой колыбельной. Здесь пели луне, когда она ещё была на небе."},{"id":14,"l":0,"t":"goldmine","c":26,"r":92,"owner":-1},{"id":15,"l":0,"t":"monster","c":28,"r":94,"owner":-1,"unit":"whitespirit","count":12,"max":36,"mood":"hostile"},{"id":16,"l":0,"t":"moonrift","c":26,"r":50,"owner":-1},{"id":17,"l":0,"t":"monster","c":26,"r":52,"owner":-1,"unit":"silverspirit","count":3,"max":9,"mood":"hostile"},{"id":18,"l":0,"t":"dwell-shard","c":40,"r":120,"owner":-1},{"id":19,"l":0,"t":"monster","c":42,"r":122,"owner":-1,"unit":"moondream","count":4,"max":12,"mood":"fierce"},{"id":20,"l":0,"t":"artifact","c":110,"r":20,"owner":-1,"art":"moonblade"},{"id":21,"l":0,"t":"monster","c":111,"r":21,"owner":-1,"unit":"moondream","count":6,"max":18,"mood":"fierce"},{"id":22,"l":0,"t":"res-gold","c":20,"r":52,"owner":-1},{"id":23,"l":0,"t":"res-gold","c":20,"r":90,"owner":-1},{"id":24,"l":0,"t":"res-gold","c":40,"r":30,"owner":-1},{"id":25,"l":0,"t":"res-gold","c":40,"r":112,"owner":-1},{"id":26,"l":0,"t":"res-gold","c":100,"r":30,"owner":-1},{"id":27,"l":0,"t":"res-gold","c":101,"r":112,"owner":-1},{"id":28,"l":0,"t":"res-gold","c":60,"r":16,"owner":-1},{"id":29,"l":0,"t":"res-gold","c":60,"r":128,"owner":-1},{"id":30,"l":0,"t":"res-moonsilver","c":24,"r":60,"owner":-1},{"id":31,"l":0,"t":"res-moonsilver","c":24,"r":84,"owner":-1},{"id":32,"l":0,"t":"res-moonsilver","c":84,"r":16,"owner":-1},{"id":33,"l":0,"t":"res-moonsilver","c":84,"r":128,"owner":-1},{"id":34,"l":0,"t":"campfire","c":30,"r":72,"owner":-1},{"id":35,"l":0,"t":"campfire","c":44,"r":26,"owner":-1},{"id":36,"l":0,"t":"campfire","c":44,"r":118,"owner":-1},{"id":37,"l":0,"t":"signstone","c":22,"r":76,"owner":-1,"text":"Стан Союза. Ночь Схождения через четыре недели. Сапоги чистить с вечера."},{"id":38,"l":0,"t":"signstone","c":76,"r":22,"owner":-1,"text":"Северный алтарь Ордена. Огни не гасить до самого Схождения."},{"id":39,"l":0,"t":"signstone","c":76,"r":122,"owner":-1,"text":"Южный алтарь Ордена. Огни не гасить, даже если очень хочется спать."},{"id":40,"l":0,"t":"rock","c":4,"r":4,"owner":-1},{"id":41,"l":0,"t":"rock","c":140,"r":140,"owner":-1},{"id":42,"l":0,"t":"rock","c":4,"r":140,"owner":-1},{"id":43,"l":0,"t":"rock","c":140,"r":4,"owner":-1}],"heroes":[{"owner":0,"hid":"valeria","c":6,"r":70,"l":0,"tag":"valeria","army":[{"unit":"legionary","count":90},{"unit":"moonarcher","count":30},{"unit":"mirrorguard","count":16},{"unit":"moonmaiden","count":12},{"unit":"deerrider","count":6},{"unit":"throneknight","count":3}]},{"owner":1,"hid":"severin","c":72,"r":76,"l":0,"tag":"regent","xp":30000,"patrol":1,"army":[{"unit":"throneknight","count":4},{"unit":"moonmaiden","count":10},{"unit":"shard","count":1},{"unit":"mirrorguard","count":20},{"unit":"legionary","count":60}]},{"owner":1,"hid":"cassian","c":71,"r":18,"l":0,"tag":"cassian","xp":12000,"patrol":2,"army":[{"unit":"legionary","count":40},{"unit":"moonarcher","count":14},{"unit":"moonmaiden","count":6}]},{"owner":1,"hid":"lucretia","c":71,"r":124,"l":0,"tag":"lucretia","xp":12000,"patrol":2,"army":[{"unit":"legionary","count":40},{"unit":"mirrorguard","count":12},{"unit":"deerrider","count":3}]},{"owner":1,"hid":"cornelius","c":130,"r":72,"l":0,"tag":"harborguard","patrol":3,"army":[{"unit":"legionary","count":30},{"unit":"moonmaiden","count":6}]}],"events":[],"scenes":"event day 1 -> v5_start\nevent day 14 -> v5_half\nevent day 24 -> v5_late\nevent visit song -> v5_song\nevent capture alt1 -> v5_alt1\nevent capture alt2 -> v5_alt2\nevent flag v5_open -> v5_gate\nevent defeat regent -> v5_regent\n\n@v5_start\nshow valeria left\nshow naera right\nnaera: Луна уже дышит. Я слышу её из любой воды. Мне нужен храм первой колыбельной, он внизу, под Срединой Чаши.\nshow aisulu right\naisulu: На мысах два алтаря Ордена. Пока они горят, луна поднимается сама.\nshow vedana right\nvedana: Мы с Айсулу погасим их. А ты, наследница, иди к регенту, когда откроется Средина.\nvaleria: Средина откроется, только если луна заснёт. Двадцать восемь ночей. Начинаем.\ngoal add song \"Довести Наэру к храму первой колыбельной\" to down song\ngoal add alt1 \"Погасить северный алтарь Ордена\" to alt1\ngoal add alt2 \"Погасить южный алтарь Ордена\" to alt2\ngoal lose day 29\nrecall adelina 8 66 0 adelina\nrecall aisulu 8 72 0 aisulu\nrecall vedana 10 72 0 vedana\nrecall naera 10 66 0 naera\nrecall irga 8 74 0 irga\narmy adelina militia 60 crossbow 20 plated 4\narmy aisulu shade 60 horsebow 20 stonewoman 8\narmy vedana werewolf 30 bereginya 12 kikimora 8\narmy naera shellman 60 harpooner 20 seawitch 8\narmy irga apprentice 60 salamander 16 caster 8\nif kept kaidar_host\narmy aisulu bonebull 3 stonekhan 1\nend\nif kept snake_alive\narmy vedana zmey 1\nend\nif kept merra_spared\narmy naera seawitch 8 rayrider 2\nend\nif kept guilds_sworn\narmy irga caster 6 slaggiant 1\nend\nif kept spared_villages\narmy adelina pikeman 30\nend\nif not diff easy\narmy regent throneknight 2 shard 1\narmy cassian mirrorguard 10\narmy lucretia mirrorguard 10\nend\nif diff impossible\narmy regent throneknight 3 shard 1\nend\nsay Средину Чаши держит стража Снов. Она уйдёт, когда Наэра споёт, а оба алтаря погаснут.\nsay Спуск к храму стоит на островке у дамбы, по пути к Средине.\nend\n\n@v5_half\nif not flag v5_open\nshow valeria left\nvaleria: Половина срока. На небе семь лун, а восьмой свет над водой стал ярче.\nend\nend\n\n@v5_late\nif not flag v5_open\nshow naera right\nnaera: Пять ночей. Луна уже не спит, она ворочается.\nend\nend\n\n@v5_song\nif beaten naera\nshow valeria left\nvaleria: Наэры нет с нами. Раковина у меня. Колыбельную споёт тот, кто её помнит.\nsay Валерия поёт колыбельную Прилива. Слова на чужом языке, но луна узнаёт мелодию.\nelse\nmove naera 74 72 1\nshow naera left\nnaera: Спи. Ты упала тысячу лет назад и до сих пор думаешь, что падаешь. Спи, мы держим.\nsay Наэра поёт. Вода в храме перестаёт дрожать.\nend\ngoal done song\nset s1\nscene v5_check\nend\n\n@v5_alt1\nshow aisulu right\naisulu: Северный алтарь погас. Огонь Ордена горел на соли из моей степи. Теперь соль просто соль.\ngoal done alt1\nset s2\nscene v5_check\nend\n\n@v5_alt2\nshow vedana right\nvedana: Южный алтарь погас. Под ним жгли мёртвые корни вместо дров. Больше не будут.\ngoal done alt2\nset s3\nscene v5_check\nend\n\n@v5_check\nif flag s1\nif flag s2\nif flag s3\nset v5_open\nend\nend\nend\nend\n\n@v5_gate\ngate open ward\nshow naera right\nnaera: Луна спит, но некрепко. Стража Снов ушла с Средины. Регент там один.\ngoal add regent \"Разбить регента в середине Чаши\" to regent\nend\n\n@v5_regent\nif not flag v5_open\ngoal done song\ngoal done alt1\ngoal done alt2\nend\nshow valeria left\nshow severin right\nseverin: Ты разбила войско, но не цепь. Половины цепи хватит, чтобы держать луну одну ночь. А одной ночи хватит, чтобы её поднять.\nif kept link_flawed\nshow irga right\nirga: Держи, регент. Тяни. Только помни, что моя половина откована с изъяном.\nsay Цепь натягивается и звенит. Звено, которое ковала Ирга, лопается, и вся цепь уходит в воду.\nelse\nshow irga right\nirga: Цепь держится на одном звене. По нему я и бью.\nsay Ирга бьёт молотом по звену, и цепь уходит в воду.\nend\nshow naera right\nnaera: Слышишь? Она засыпает. Она больше не падает.\nshow severin right\nseverin: Сорок лет я учил руины помнить. А они помнят только тебя.\nvaleria: Они помнят царей, Северин. Цари ушли под воду. Пусть там и спят.\nchoice\n- Сесть на Белый престол. Руинам нужен хозяин, а не царица луны. -> v5_take\n- Оставить трон пустым. Белые руины будут помнить, а не править. -> v5_leave\nend\nend\n\n@v5_take\nshow valeria left\nvaleria: Я сяду на этот трон. Без луны над головой и без цепи. Пусть Престол будет просто городом на утёсе.\nkeep throne_taken\ngoal done regent\nwin\nend\n\n@v5_leave\nshow valeria left\nvaleria: Трон останется пустым. Пусть рыцари служат клятве, а не тому, кто на нём сидит. Я пойду смотреть, как просыпается Венец.\nkeep throne_left\ngoal done regent\nwin\nend\n"}